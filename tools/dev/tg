#!/usr/bin/env bash
# tg — local development helper for this Telegram-iOS fork.
#
# Wraps build-system/Make/Make.py with fast, disk-friendly defaults for
# simulator work. Run `tools/dev/tg help` for commands; see
# docs/local-development.md for the reasoning behind each default.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# The app bundle inside bazel-bin/Telegram/ and Telegram.ipa (Telegram/BUILD bundle_name); its executable has the same name.
APP_NAME="Nanogram"
# Simulator builds (tree artifact): rules_apple puts a bundle whose name differs from the target under <target>_archive-root.
SIM_APP="$ROOT/bazel-bin/Telegram/Telegram_archive-root/Payload/${APP_NAME}.app"
# The app's dSYM: a fresh build puts it in Telegram_dsyms/Nanogram.app.dSYM (rules_apple, the bundle is named Nanogram
# since 2026-11-08); builds before the rename left Telegram.app.dSYM (DWARF/Telegram) next to the ipa. archive_dsyms
# takes the first that exists and checks its UUID against the app either way.
APP_DSYMS=("Telegram_dsyms/${APP_NAME}.app.dSYM" "Telegram.app.dSYM")
# Relative paths on the command line (tg testflight --notes) are the caller's, not the repository's.
CALLER_PWD="$PWD"
cd "$ROOT"

CACHE_DIR="${TG_CACHE_DIR:-$HOME/.cache/telegram-ios/bazel-disk-cache}"
CONFIG="${TG_CONFIG:-$ROOT/build-system/dev-configuration.json}"
CODESIGNING="${TG_CODESIGNING:-$ROOT/build-system/fake-codesigning}"
UPSTREAM_URL="https://github.com/TelegramMessenger/Telegram-iOS.git"

# Device builds keep every output in bazel-out instead of only the top-level ones
# (Bazel's default --remote_download_outputs=toplevel also applies to the disk cache).
# With toplevel, a disk-cache hit leaves e.g. libPostbox.a only as a digest in the
# output base; device builds are rare, so the disk-cache GC (.bazelrc, 20G) evicts
# that blob during simulator work, and the next device build fails to link with
# "Failed to fetch blobs ... Missing digest" (exit REMOTE_CACHE_EVICTED) instead of
# rebuilding it. Simulator builds keep the default.
DEVICE_DOWNLOAD_OUTPUTS="--remote_download_outputs=all"

bazel_version() { python3 -c 'import json;print(json.load(open("versions.json"))["bazel"].split(":")[0])'; }
xcode_version() { python3 -c 'import json;print(json.load(open("versions.json"))["xcode"])'; }
bazel_bin() { echo "$ROOT/build-input/bazel-$(bazel_version)-darwin-$(uname -m)"; }

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

size_of() { if [ -e "$1" ]; then du -sh "$1" 2>/dev/null | cut -f1; else echo "-"; fi; }

require_config() {
  [ -f "$CONFIG" ] || die "no build configuration at $CONFIG. Run: tools/dev/tg setup"
}

# Make.py checks Xcode against versions.json; upstream's own dev command always
# overrides it, so do the same and let `doctor` report a mismatch instead.
make_py() {
  python3 -u build-system/Make/Make.py --overrideXcodeVersion --cacheDir="$CACHE_DIR" "$@"
}

cmd_setup() {
  say "Configuring git for a large repository"
  git config core.untrackedCache true
  git config feature.manyFiles true
  git config fetch.parallel 0
  git config submodule.fetchJobs 0
  # Recorded conflict resolutions (DebugController, branding, ...) are replayed on the next upstream merge.
  git config rerere.enabled true
  git config rerere.autoupdate true
  # Built-in FSEvents monitor (git >= 2.37) keeps `git status` fast on ~49k files.
  # (`git help -a` hides double-dash commands, so probe the daemon directly.)
  if ! git fsmonitor--daemon status 2>&1 | grep 'not a git command' >/dev/null; then
    git config core.fsmonitor true
  fi

  say "Fetching submodules (shallow)"
  git submodule sync --recursive >/dev/null
  git submodule update --init --recursive --depth 1 --jobs 8

  mkdir -p "$CACHE_DIR"

  if [ ! -f "$CONFIG" ]; then
    cp build-system/appstore-configuration.json "$CONFIG"
    say "Created $CONFIG from appstore-configuration.json"
    warn "Replace api_id and api_hash in it with your own (https://my.telegram.org/apps)."
    warn "Keep bundle_id/team_id unless you also provide matching provisioning profiles."
  fi

  if [ ! -f user.bazelrc ]; then
    cat > user.bazelrc <<EOF
# Personal Bazel settings (not checked in). Examples:
# common --experimental_disk_cache_gc_max_size=20G
# build --jobs=8
EOF
    say "Created user.bazelrc for personal overrides"
  fi

  cmd_doctor || true
}

cmd_doctor() {
  local ok=0
  local want_xcode; want_xcode="$(xcode_version)"
  # Ignore DEVELOPER_DIR: Bazel runs the third-party genrules (webp, ffmpeg, ...)
  # without it, and they call xcode-select themselves.
  local dev_dir; dev_dir="$(env -u DEVELOPER_DIR xcode-select -p 2>/dev/null || true)"
  if [[ "$dev_dir" != *Xcode*.app* ]]; then
    warn "xcode-select points at '$dev_dir'. Install Xcode $want_xcode and run: sudo xcode-select -s /Applications/Xcode.app"
    ok=1
  else
    local have; have="$(xcodebuild -version 2>/dev/null | awk 'NR==1{print $2}')"
    if [ "$have" != "$want_xcode" ]; then
      warn "Xcode $have is selected, this release expects $want_xcode (versions.json). Builds may fail."
      ok=1
    else
      say "Xcode $have"
    fi
    # Xcode 26+ ships the Metal compiler as a separate download; the app's shaders need it.
    if ! xcrun metal --version >/dev/null 2>&1; then
      warn "Metal Toolchain missing. Run: xcodebuild -downloadComponent MetalToolchain"
      ok=1
    fi
  fi
  [ -f "$CONFIG" ] && say "Configuration: $CONFIG" || { warn "Missing $CONFIG (run: tools/dev/tg setup)"; ok=1; }
  if git submodule status --recursive | grep '^-' >/dev/null; then
    warn "Some submodules are not checked out (run: tools/dev/tg setup)"; ok=1
  fi
  # BUILD files glob these sources: an empty (not initialised) directory builds silently with nothing in it.
  local sentinel
  for sentinel in \
    submodules/ffmpeg/Sources/FFMpeg/ffmpeg-9.0.2/RELEASE \
    third-party/boost_regex/regex/include/boost/regex.hpp \
    third-party/wamr/wamr/LICENSE \
    third-party/ogg/ogg/src/framing.c \
    third-party/opusfile/opusfile/src/opusfile.c \
    third-party/webp/libwebp/src/webp/decode.h \
    ; do
    [ -f "$ROOT/$sentinel" ] || { warn "Source submodule is empty: ${sentinel%/*} (run: tools/dev/tg setup)"; ok=1; }
  done
  local free; free="$(df -g "$ROOT" | awk 'NR==2{print $4}')"
  if [ "${free:-0}" -lt 60 ]; then
    warn "Only ${free} GB free. A first full debug build needs roughly 40-60 GB (output base + disk cache)."
    ok=1
  else
    say "Free disk: ${free} GB"
  fi
  local expires
  expires="$(security cms -D -i "$ROOT/build-system/fake-codesigning/profiles/Telegram.mobileprovision" 2>/dev/null \
    | plutil -extract ExpirationDate raw - 2>/dev/null || true)"
  if [ -n "$expires" ] && [ "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \> "$expires" ]; then
    warn "The fake provisioning profiles expired on $expires, so device builds fail (run: tools/dev/tg refresh-fake-profiles)"
    ok=1
  fi
  return $ok
}

# tg build [--release] [--device] [--full] [-- extra Make.py build args]
cmd_build() {
  require_config
  local configuration full=0 bazel_args=() extra=()
  local release=0 device=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) release=1 ;;
      --device) device=1 ;;
      --full) full=1 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown build option: $1" ;;
    esac
    shift
  done
  case "$release$device" in
    00) configuration=debug_sim_arm64 ;;
    10) configuration=release_sim_arm64 ;;
    01) configuration=debug_arm64 ;;
    11) configuration=release_arm64 ;;
  esac
  # The app extensions (Share, Notification Service/Content, Intents, Widget)
  # are separate binaries that most UI work never touches.
  if [ $full -eq 0 ]; then bazel_args+=("--//Telegram:disableExtensions"); fi
  if [ $device -eq 1 ]; then bazel_args+=("$DEVICE_DOWNLOAD_OUTPUTS"); fi
  if [ $device -eq 1 ] && security show-keychain-info "$FAKE_KEYCHAIN" >/dev/null 2>&1; then
    security unlock-keychain -p "" "$FAKE_KEYCHAIN" 2>/dev/null || true
  fi
  if [ $device -eq 0 ]; then
    # Simulator builds need no provisioning profiles, and nothing installs them
    # from an .ipa: output ${APP_NAME}.app as a directory instead of zipping the whole
    # bundle into Telegram.ipa on every build.
    bazel_args+=("--//Telegram:disableProvisioningProfiles")
    bazel_args+=("--define=apple.experimental.tree_artifact_outputs=1")
  fi
  # Debug builds: line tables only for third-party C/C++ (WebRTC alone is ~3,000
  # files). Backtraces keep file and line numbers; stepping through variables in
  # those libraries needs `tg build -- --bazelArguments=...` without it. Smaller
  # objects, less disk, faster compiles. Telegram's own code keeps full debug info.
  if [ $release -eq 0 ]; then bazel_args+=("--per_file_copt=^third-party/.*@-gline-tables-only"); fi

  local make_args=()
  if [ ${#bazel_args[@]} -gt 0 ]; then
    make_args+=("--bazelArguments=${bazel_args[*]}")
  fi
  # ${a[@]+"${a[@]}"}: empty arrays are "unbound" under set -u in macOS bash 3.2.
  make_py ${make_args[@]+"${make_args[@]}"} build \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    --buildNumber="${TG_BUILD_NUMBER:-1}" \
    --configuration="$configuration" \
    ${extra[@]+"${extra[@]}"}
  if [ $device -eq 0 ]; then
    # No Telegram name or logo where the app means itself (tools/dev/lint/branding.py).
    python3 "$ROOT/tools/dev/lint/branding.py" --bundle "$SIM_APP"
    say "Built: $SIM_APP"
  else
    say "Built: $ROOT/bazel-bin/Telegram/Telegram.ipa"
  fi
}

# tg run [build options] — build for the simulator, install and launch it on the
# test simulator (build-system/bazel-utils/test_simulator.bzl), creating and
# booting that simulator if needed.
cmd_run() {
  cmd_build "$@"
  local device os bundle_id udid app_path installed
  device="$(sed -n 's/^TEST_SIMULATOR_DEVICE = "\(.*\)"$/\1/p' build-system/bazel-utils/test_simulator.bzl)"
  os="$(sed -n 's/^TEST_SIMULATOR_OS = "\(.*\)"$/\1/p' build-system/bazel-utils/test_simulator.bzl)"
  bundle_id="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["bundle_id"])' "$CONFIG")"
  udid="$(xcrun simctl list devices "iOS $os" | sed -n "s/^ *$device (\([0-9A-F-]*\)).*/\1/p" | head -1)"
  if [ -z "$udid" ]; then
    udid="$(xcrun simctl create "$device" "com.apple.CoreSimulator.SimDeviceType.${device// /-}" \
      "com.apple.CoreSimulator.SimRuntime.iOS-${os//./-}")"
  fi
  xcrun simctl bootstatus "$udid" -b >/dev/null
  # Show the device window: Simulator.app in older Xcodes, DeviceHub in Xcode 27.
  local dev_dir; dev_dir="$(env -u DEVELOPER_DIR xcode-select -p)"
  if [ -d "$dev_dir/Applications/Simulator.app" ]; then
    open "$dev_dir/Applications/Simulator.app" --args -CurrentDeviceUDID "$udid" || true
  else
    open "$dev_dir/../Applications/DeviceHub.app" || true
  fi
  [ -x "$SIM_APP/${APP_NAME}" ] || die "no app at $SIM_APP"
  # Bazel outputs are read-only and simctl needs a writable bundle: stage an APFS
  # clone (instant, no extra space) and install from that.
  local stage; stage="$(mktemp -d)"
  app_path="$stage/${APP_NAME}.app"
  cp -Rc "$SIM_APP" "$app_path" && chmod -R u+w "$app_path"
  xcrun simctl terminate "$udid" "$bundle_id" 2>/dev/null || true
  # `simctl install` keeps the old binary when the build number is unchanged, so
  # replace an installed bundle in place (the data container is separate).
  installed="$(xcrun simctl get_app_container "$udid" "$bundle_id" app 2>/dev/null || true)"
  if [ -n "$installed" ] && [ -d "$installed" ]; then
    rm -rf "$installed" && cp -Rp "$app_path" "$installed"
  else
    xcrun simctl install "$udid" "$app_path"
  fi
  rm -rf "$stage"
  xcrun simctl launch "$udid" "$bundle_id" >/dev/null
  say "Running on $device (iOS $os, $udid)"
}

# tg project [--full] — generate and open the Xcode project (simulator, no extensions).
cmd_project() {
  require_config
  local args=(--disableProvisioningProfiles)
  [ "${1:-}" = "--full" ] || args+=(--disableExtensions)
  make_py generateProject \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    "${args[@]}"
}

# tg test [label]
cmd_test() {
  require_config
  make_py test \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    ${1:+--target="$1"}
}

FAKE_KEYCHAIN="telegram-fake-codesigning.keychain-db"

# tg fake-signing [--remove] — put the public fake signing identity from
# build-system/fake-codesigning/certs into its own keychain, so `tg build --device`
# can sign with the fake profiles (the result compiles, links and signs, but cannot
# be installed on a phone). The keychain has an empty password and never locks on
# its own; --remove deletes it again.
cmd_fake_signing() {
  if [ "${1:-}" = "--remove" ]; then
    security delete-keychain "$FAKE_KEYCHAIN" 2>/dev/null || true
    say "Removed $FAKE_KEYCHAIN"
    return 0
  fi
  if ! security show-keychain-info "$FAKE_KEYCHAIN" >/dev/null 2>&1; then
    security create-keychain -p "" "$FAKE_KEYCHAIN"
  fi
  security set-keychain-settings "$FAKE_KEYCHAIN"
  security unlock-keychain -p "" "$FAKE_KEYCHAIN"
  security import "$ROOT/build-system/fake-codesigning/certs/SelfSigned.p12" -k "$FAKE_KEYCHAIN" -P "" \
    -T /usr/bin/codesign -T /usr/bin/security >/dev/null 2>&1 || true
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "" "$FAKE_KEYCHAIN" >/dev/null
  local current
  current="$(security list-keychains -d user | tr -d '"' | xargs)"
  case " $current " in
    *"/$FAKE_KEYCHAIN "*) ;;
    *) eval "security list-keychains -d user -s $current \"\$HOME/Library/Keychains/$FAKE_KEYCHAIN\"" ;;
  esac
  security find-identity -p codesigning "$FAKE_KEYCHAIN" | sed -n '1,3p'
  say "Fake signing identity installed in $FAKE_KEYCHAIN"
}

# tg new-module <dir> — scaffold a Swift module that uses the strict Swift preset
# (build-system/bazel-utils/swift_strict.bzl) and a host unit test, then run the test.
cmd_new_module() {
  local path="${1:-}"
  [ -n "$path" ] || die "usage: tools/dev/tg new-module <dir>   (e.g. submodules/MyFeature)"
  path="${path%/}"
  local name; name="$(basename "$path")"
  [[ "$name" =~ ^[A-Z][A-Za-z0-9]*$ ]] || die "the directory name is the module name and must be UpperCamelCase: $name"
  [ ! -e "$path" ] || die "$path already exists"
  mkdir -p "$path/Sources" "$path/Tests"
  cat > "$path/BUILD" <<EOF
load("//build-system/bazel-utils:swift_strict.bzl", "strict_swift_library", "strict_swift_test")

strict_swift_library(
    name = "$name",
    module_name = "$name",
    srcs = glob(["Sources/**/*.swift"]),
    deps = [],
    visibility = ["//visibility:public"],
)

# Runs on the Mac (tools/dev/tg new-module ran it once). Keep it while the module
# needs only Foundation; a module that imports UIKit needs an ios_unit_test instead.
strict_swift_test(
    name = "${name}Tests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":$name"],
)
EOF
  cat > "$path/Sources/$name.swift" <<EOF
public enum $name {
    public static let name = "$name"
}
EOF
  cat > "$path/Tests/${name}Tests.swift" <<EOF
import XCTest
@testable import $name

final class ${name}Tests: XCTestCase {
    func testName() {
        XCTAssertEqual($name.name, "$name")
    }
}
EOF
  say "Created $path (strict Swift 6). Checking that it builds and its test passes"
  "$(bazel_bin)" test "//$path:${name}Tests" --test_output=errors
  say "Add \"//$path\" to the deps of the module that uses it"
}

# tg strict-report — count Swift 6 concurrency problems per module.
#
# Builds the app once with -strict-concurrency=complete, reporting every problem as
# a warning so the whole tree is checked in one pass. It rebuilds all Swift code
# (about 15 minutes) and replaces the normal build outputs; the next `tg build`
# restores them from the disk cache, which this build does not write to.
cmd_strict_report() {
  require_config
  local dir; dir="$(dirname "$CACHE_DIR")"
  local log="$dir/strict-report.log" report="$dir/strict-report.txt"
  mkdir -p "$dir"
  say "Building with Swift 6 concurrency checking (log: $log)"
  local flags="--//Telegram:disableExtensions --//Telegram:disableProvisioningProfiles"
  flags+=" --@build_bazel_rules_swift//swift:copt=-strict-concurrency=complete"
  flags+=" --@build_bazel_rules_swift//swift:copt=-no-warnings-as-errors"
  flags+=" --disk_cache= --experimental_ui_max_stdouterr_bytes=-1"
  make_py "--bazelArguments=$flags" build --continueOnError \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    --buildNumber=1 --configuration=debug_sim_arm64 >"$log" 2>&1 || true
  python3 "$ROOT/build-system/Make/StrictReport.py" "$ROOT" "$log" "$(bazel_bin)" | tee "$report"
  say "Report saved to $report. Run tools/dev/tg build to restore the normal outputs"
}

cmd_disk() {
  local bazel; bazel="$(bazel_bin)"
  printf '%-34s %s\n' "Source checkout (incl. .git)" "$(size_of "$ROOT")"
  printf '%-34s %s\n' "  .git (+ submodule objects)" "$(size_of "$ROOT/.git")"
  printf '%-34s %s\n' "Bazel disk cache ($CACHE_DIR)" "$(size_of "$CACHE_DIR")"
  if [ -x "$bazel" ]; then
    local output_base repo_cache
    output_base="$("$bazel" info output_base 2>/dev/null || true)"
    repo_cache="$("$bazel" info repository_cache 2>/dev/null || true)"
    printf '%-34s %s\n' "Bazel output base" "$(size_of "$output_base")"
    printf '%-34s %s\n' "  Xcode project builds (nested)" "$(size_of "$output_base/rules_xcodeproj.noindex")"
    printf '%-34s %s\n' "Bazel repository cache" "$(size_of "$repo_cache")"
  else
    echo "Bazel output base                  (bazel not downloaded yet)"
  fi
  local dd=( "$HOME"/Library/Developer/Xcode/DerivedData/Telegram-* )
  if [ -e "${dd[0]}" ]; then
    printf '%-34s %s\n' "Xcode DerivedData (Telegram-*)" "$(du -shc "${dd[@]}" | tail -1 | cut -f1)"
  fi
}

# tg clean — drop build outputs, keep downloaded repositories and the disk cache.
cmd_clean() {
  local bazel; bazel="$(bazel_bin)"
  [ -x "$bazel" ] || die "bazel not downloaded yet"
  "$bazel" clean
}

# tg cache-cleanup [--dry-run] [--only A,B] | verify | report — the shared cache cleanup (tools/dev/cachegc, one policy
# for the iOS and the Mac app). It also runs by itself, throttled and time-boxed, after build, test, run, device and
# testflight commands. There is no scheduled job.
cmd_cache_cleanup() {
  case "${1:-}" in
    verify|report|guard) python3 "$ROOT/tools/dev/cachegc/cachegc.py" "$1" --repo "$ROOT" ;;
    *) python3 "$ROOT/tools/dev/cachegc/cachegc.py" run --repo "$ROOT" "$@" ;;
  esac
}

# tg upstream-sync --tag <upstream tag> [--offline] [--json]: dry run of an upstream release merge (conflicts by area,
# bumped pins against our fork branches). Works in a scratch repository; changes and fetches nothing in this repo.
cmd_upstream_sync() { python3 "$ROOT/tools/dev/upstream-sync/sync.py" --repo "$ROOT" "$@"; }

cache_cleanup_auto() { python3 "$ROOT/tools/dev/cachegc/cachegc.py" auto --repo "$ROOT" || true; }

# Runs before every build command (not throttled): enforces the hard caps, stops Bazel servers of deleted worktrees, and
# refuses to start a build below the hard free-space floor (cache-policy.json; TG_ALLOW_LOW_DISK=1 overrides).
# A command that calls another tg command is guarded once.
cache_guard() {
  [ -z "${TG_CACHE_GUARDED:-}" ] || return 0
  export TG_CACHE_GUARDED=1
  [ -f "$ROOT/tools/dev/cachegc/cachegc.py" ] || return 0
  local status=0
  python3 "$ROOT/tools/dev/cachegc/cachegc.py" guard --repo "$ROOT" || status=$?
  # Exit 1 is the refusal (too little free disk); any other failure of the guard itself must not stop a build.
  [ "$status" -ne 1 ] || exit 1
}

# tg worktree add <name> [--branch B] [--from REF] | remove <name> [--force] — tools/dev/worktree/worktree.py (the same
# module in both repos). Nothing is built.
cmd_worktree() { python3 "$ROOT/tools/dev/worktree/worktree.py" --repo "$ROOT" --flavor ios "$@"; }

# tg native — drift check: native-libs.json and module-settings.json against the build files.
cmd_native() { python3 "$ROOT/tools/dev/native/check_native_libs.py" "$@" && python3 "$ROOT/tools/dev/native/module_settings.py" --check; }

# tg prune [--yes] — reclaim everything Bazel and Xcode keep for this checkout.
cmd_prune() {
  if [ "${1:-}" != "--yes" ]; then
    echo "This deletes the Bazel output base (bazel clean --expunge), the disk cache at"
    echo "$CACHE_DIR and Telegram-* DerivedData. The next build starts cold."
    echo "Re-run with: tools/dev/tg prune --yes"
    return 1
  fi
  local bazel; bazel="$(bazel_bin)"
  if [ -x "$bazel" ]; then "$bazel" clean --expunge; fi
  rm -rf "$CACHE_DIR"
  rm -rf "$HOME"/Library/Developer/Xcode/DerivedData/Telegram-*
  say "Pruned"
}

# tg sync-upstream <tag> — import an official release onto the `upstream` branch.
cmd_sync_upstream() {
  local tag="${1:-}"
  [ -n "$tag" ] || die "usage: tools/dev/tg sync-upstream <tag>   (e.g. release-13.2)"
  git remote get-url telegram >/dev/null 2>&1 || git remote add telegram "$UPSTREAM_URL"
  say "Fetching $tag (depth 1)"
  git fetch --depth 1 --no-tags telegram "refs/tags/$tag:refs/telegram-tags/$tag"
  local commit tree parent new
  commit="$(git rev-parse "refs/telegram-tags/$tag^{commit}")"
  tree="$(git rev-parse "$commit^{tree}")"
  parent="$(git rev-parse upstream)"
  if [ "$(git rev-parse "upstream^{tree}")" = "$tree" ]; then
    say "upstream already matches $tag"; return 0
  fi
  new="$(git commit-tree "$tree" -p "$parent" -m "Import upstream Telegram-iOS $tag

Snapshot of $UPSTREAM_URL at tag $tag (commit $commit), imported without history.

Upstream-Tag: $tag
Upstream-Commit: $commit")"
  git update-ref refs/heads/upstream "$new" "$parent"
  say "upstream -> $tag ($(git rev-parse --short "$new")). Next:"
  echo "  git switch main && git merge upstream"
  echo "  git submodule update --init --recursive --depth 1 --jobs 8"
}

# tg device [--no-install] — release build signed for your own iPhone, then install it.
# Uses ~/.config/telegram-ios/device-configuration.json (bundle id, team, your api_id) and the
# profiles that `python3 tools/dev/device_signing.py profiles` puts in
# ~/.config/telegram-ios/codesigning (paid team: push and app extensions). Without those
# profiles it falls back to Xcode's free signing, which has no push and no extensions.
# profile_aps_environment <profile> — the aps-environment a provisioning profile grants, empty for none.
profile_aps_environment() {
  security cms -D -i "$1" 2>/dev/null | plutil -extract Entitlements.aps-environment raw -o - - 2>/dev/null || true
}

# warn_device_push_environment <app profile> — device builds are release_arm64, which registers its
# push tokens with Telegram as production (app_sandbox=false, SharedAccountContext). Development
# profiles (the only kind device_signing.py profiles makes) grant aps-environment=development, so
# APNs hands the app a sandbox token that Telegram's production pushes never reach: no messages,
# no calls. Apple issues development profiles with development push only, so the mismatch cannot
# be signed away here; TestFlight builds are re-signed for distribution (production) and match.
# profile_has_enhanced_security <profile> — the App ID has the Enhanced Security capability and the
# profile grants it (device_signing.py profiles asks for it). Signing hardened-process entitlements
# the profile does not grant fails the build, so tg device only adds them when this holds.
profile_has_enhanced_security() {
  [ "$(security cms -D -i "$1" 2>/dev/null | plutil -extract Entitlements.com\\.apple\\.security\\.hardened-process raw -o - - 2>/dev/null)" = "true" ]
}

warn_device_push_environment() {
  local aps
  aps="$(profile_aps_environment "$1")"
  [ "$aps" = "production" ] && return 0
  warn "================================================================================"
  warn "THIS INSTALL GETS NO PUSH NOTIFICATIONS OR INCOMING CALLS while the app is closed."
  warn "Its profile grants aps-environment='${aps:-none}', but this release build registers"
  warn "its push token with Telegram as production, so Telegram's pushes never reach it."
  warn "Test notifications and calls with a TestFlight build: tools/dev/tg testflight"
  warn "================================================================================"
}

cmd_device() {
  local config="${TG_DEVICE_CONFIG:-$HOME/.config/telegram-ios/device-configuration.json}"
  local signing="${TG_DEVICE_CODESIGNING:-$HOME/.config/telegram-ios/codesigning}"
  local install=1 watch=0 app_store=0 udid="${TG_DEVICE_UDID:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-install) install=0 ;;
      --watch) watch=1 ;;
      # Internal (tg testflight): the build is re-signed for distribution before it ships.
      --app-store) app_store=1 ;;
      *) die "unknown device option: $1" ;;
    esac
    shift
  done
  [ -f "$config" ] || die "no device configuration at $config"

  local signing_args=() bazel_args=("$DEVICE_DOWNLOAD_OUTPUTS")
  if ls "$signing/profiles/"*.mobileprovision >/dev/null 2>&1; then
    signing_args=(--codesigningInformationPath="$signing")
  else
    warn "no profiles in $signing/profiles (run: python3 tools/dev/device_signing.py profiles)"
    warn "using free Xcode signing: no push notifications, no app extensions"
    signing_args=(--xcodeManagedCodesigning)
    bazel_args+=("--//Telegram:disableExtensions")
  fi
  # Enhanced Security (soft mode) when the profiles of the app, NotificationService and Share grant it.
  # A TestFlight build (--app-store) is signed with the development profiles first and re-signed for
  # distribution by device_signing.py testflight, which keeps the entitlements and fails before the
  # upload if the distribution profiles do not grant them. TG_TF_ENHANCED_SECURITY=0 ships without.
  local es_missing=""
  if [ -f "$signing/profiles/Telegram.mobileprovision" ]; then
    local es_name
    for es_name in Telegram NotificationService Share; do
      profile_has_enhanced_security "$signing/profiles/$es_name.mobileprovision" || es_missing="$es_missing $es_name"
    done
  else
    es_missing=" Telegram"
  fi
  if [ $app_store -eq 1 ] && [ "${TG_TF_ENHANCED_SECURITY:-1}" = "0" ]; then
    warn "Enhanced Security is OFF for this TestFlight build (TG_TF_ENHANCED_SECURITY=0)"
  elif [ -z "$es_missing" ]; then
    bazel_args+=("--//Telegram:enhancedSecurity")
    say "Enhanced Security (soft mode) on: the profiles grant it"
  elif [ $app_store -eq 1 ]; then
    die "TestFlight builds ship with Enhanced Security, but the profiles of$es_missing do not grant it. Enable the capability on the App IDs, regenerate (python3 tools/dev/device_signing.py profiles), or TG_TF_ENHANCED_SECURITY=0 to ship without."
  else
    warn "Enhanced Security stays off: the profiles of$es_missing do not grant it"
  fi
  local make_args=("--bazelArguments=${bazel_args[*]}")
  local watch_args=()
  if [ $watch -eq 1 ]; then
    # The embedded Apple Watch app (Telegram/WatchApp) uses the same api_id as the phone app.
    # Without a WatchApp.mobileprovision it is built unsigned; tg testflight signs it for the App Store.
    local creds="$HOME/.config/telegram-ios/api-credentials.json"
    [ -f "$creds" ] || die "no API credentials at $creds"
    watch_args=(--embedWatchApp
      --watchApiId="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["api_id"])' "$creds")"
      --watchApiHash="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["api_hash"])' "$creds")")
    [ -f "$signing/profiles/WatchApp.mobileprovision" ] \
      && watch_args+=(--watchProvisioningProfile="$signing/profiles/WatchApp.mobileprovision")
  fi
  make_py ${make_args[@]+"${make_args[@]}"} build \
    --configurationPath="$config" \
    "${signing_args[@]}" \
    ${watch_args[@]+"${watch_args[@]}"} \
    --buildNumber="${TG_BUILD_NUMBER:-1}" \
    --configuration=release_arm64
  say "Built: $ROOT/bazel-bin/Telegram/Telegram.ipa"
  # Keep this build's dSYMs, as tg testflight does (which archives its own, after this returns): an
  # Instruments recording of the device build can only be symbolicated with them. The next build
  # overwrites bazel-bin's. A build without usable dSYMs still installs.
  if [ $app_store -eq 0 ]; then
    ( archive_dsyms "$ROOT/bazel-bin/Telegram/Telegram.ipa" ) \
      || warn "dSYMs were not archived for this build: its traces will not symbolicate"
  fi
  if [ $app_store -eq 0 ] && [ -f "$signing/profiles/Telegram.mobileprovision" ]; then
    warn_device_push_environment "$signing/profiles/Telegram.mobileprovision"
  fi
  [ $install -eq 1 ] || return 0

  if [ -z "$udid" ]; then
    udid="$(xcrun devicectl list devices 2>/dev/null | awk '/physical/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9A-F]{8}-[0-9A-F]{16}$/) { print $i; exit } }')"
  fi
  [ -n "$udid" ] || die "no iPhone found: connect it (cable or same Wi-Fi) and unlock it, or set TG_DEVICE_UDID"
  local unpacked
  unpacked="$(mktemp -d)"
  unzip -q "$ROOT/bazel-bin/Telegram/Telegram.ipa" -d "$unpacked"
  # The phone sometimes rejects a valid signature once (0xe8008001); a second attempt installs.
  xcrun devicectl device install app --device "$udid" "$unpacked/Payload/${APP_NAME}.app" \
    || xcrun devicectl device install app --device "$udid" "$unpacked/Payload/${APP_NAME}.app"
  rm -rf "$unpacked"
  say "Installed on $udid"
}

# Every TestFlight build's dSYMs, one directory per CFBundleVersion. Outside the repository and
# every cache, so `tg clean`/`tg prune`, Bazel's disk-cache GC and cache cleanups never delete them;
# a crash report from a tester (MetricKit, Xcode Organizer) can only be symbolicated with them.
# Every build is kept (TG_DSYM_KEEP=0, the default): a TestFlight build's dSYMs live forever. Set TG_DSYM_KEEP=N to keep
# only the N highest build numbers.
DSYM_ARCHIVE="${TG_DSYM_DIR:-$HOME/Library/Application Support/Nanogram/dsyms}"
DSYM_KEEP="${TG_DSYM_KEEP:-0}"

# ipa_binary_uuids <ipa> <work dir> — "<path in ipa> <UUID>" for every slice of every bundle
# executable in <ipa> (the app, its extensions, frameworks and watch app), extracting only the
# Info.plists and executables into <work dir>.
ipa_binary_uuids() {
  local ipa="$1" work="$2" entries plist executable
  local plists=() executables=()
  entries="$(unzip -Z1 "$ipa")"
  while IFS= read -r plist; do
    plists+=("$plist")
  done < <(echo "$entries" | grep -E '^Payload/(.*/)?[^/]+\.(app|appex|framework)/Info\.plist$' || true)
  [ ${#plists[@]} -gt 0 ] || die "no bundles in $ipa"
  unzip -qo "$ipa" "${plists[@]}" -d "$work"
  for plist in "${plists[@]}"; do
    executable="${plist%/Info.plist}/$(plutil -extract CFBundleExecutable raw -o - "$work/$plist" 2>/dev/null)" || continue
    # A static framework embedded as a stub has an Info.plist and no executable.
    if grep -Fxq "$executable" <<<"$entries"; then executables+=("$executable"); fi
  done
  [ ${#executables[@]} -gt 0 ] || die "no executables in $ipa"
  unzip -qo "$ipa" "${executables[@]}" -d "$work"
  for executable in "${executables[@]}"; do
    dwarfdump --uuid "$work/$executable" | awk -v path="$executable" '{ print path, $2 }'
  done
}

# prune_dsym_archive <build just archived> — keep the $DSYM_KEEP builds with the highest build
# numbers in $DSYM_ARCHIVE, and always <build just archived>. A build is a directory named by its
# build number (digits and dots) with a uuids.txt; anything else there is left alone. Ranked by
# build number, not mtime: an mtime moves whenever a folder is touched.
prune_dsym_archive() {
  local current="$1" keep="$DSYM_KEEP" dir count=1
  case "$keep" in
    ""|*[!0-9]*) warn "TG_DSYM_KEEP='$keep' is not a number; keeping every build"; keep=0 ;;
  esac
  [ "$keep" -ge 1 ] || return 0
  while IFS= read -r dir; do
    [ "$dir" != "$current" ] || continue
    case "$dir" in ""|.*|*[!0-9.]*) continue ;; esac
    [ -f "$DSYM_ARCHIVE/$dir/uuids.txt" ] || continue
    # The build just archived holds the first place.
    count=$((count + 1))
    if [ "$count" -gt "$keep" ]; then
      rm -rf "${DSYM_ARCHIVE:?}/$dir"
      say "Removed the dSYMs of build $dir (keeping $keep builds)"
    fi
  done < <(ls -1 "$DSYM_ARCHIVE" | sort -t. -k1,1nr -k2,2nr -k3,3nr -k4,4nr)
}

# archive_dsyms <ipa> — zip the dSYMs built with <ipa> (Make.py's release_arm64 builds them next to
# it: --apple_generate_dsym --output_groups=+dsyms) into $DSYM_ARCHIVE/<CFBundleVersion>/, one
# <name>.dSYM.zip each plus uuids.txt, and set ARCHIVED_DSYM_DIR. Only dSYMs whose UUIDs belong to a
# binary in <ipa> are archived: bazel-bin keeps dSYMs of earlier builds (an extension since removed,
# another configuration). The folder is emptied first, so a rebuilt build number holds this build's
# alone. Fails when the app's dSYM does not match the app in <ipa>, so a build is never uploaded
# without symbols we can use.
archive_dsyms() {
  local ipa="$1" outdir binaries version app_uuids dsym_uuids dest dsym name uuid matched
  outdir="$(cd -P "$(dirname "$ipa")" && pwd)"
  local candidates=() dsyms=() app_dsym=""
  for dsym in "$outdir"/*.dSYM "$outdir"/Telegram_dsyms/*.dSYM; do [ -d "$dsym" ] && candidates+=("$dsym"); done
  [ ${#candidates[@]} -gt 0 ] || die "no dSYMs next to $ipa"
  for dsym in "${APP_DSYMS[@]}"; do
    if [ -d "$outdir/$dsym" ]; then
      app_dsym="$outdir/$dsym"
      break
    fi
  done
  [ -n "$app_dsym" ] || die "no app dSYM next to $ipa (${APP_DSYMS[*]})"

  # In a subshell, so its EXIT trap removes the extracted files whatever happens.
  binaries="$(
    set -e
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    unzip -qo "$ipa" Payload/${APP_NAME}.app/Info.plist -d "$work"
    echo "version $(plutil -extract CFBundleVersion raw -o - "$work/Payload/${APP_NAME}.app/Info.plist")"
    ipa_binary_uuids "$ipa" "$work"
  )" || die "cannot read the binaries in $ipa"
  version="$(echo "$binaries" | awk '$1 == "version" { print $2 }')"
  case "$version" in
    ""|.*|*[!0-9.]*) die "no usable CFBundleVersion in $ipa: '$version'" ;;
  esac
  app_uuids="$(echo "$binaries" | awk -v app="Payload/${APP_NAME}.app/${APP_NAME}" '$1 == app { print $2 }' | sort | xargs)"
  dsym_uuids="$(dwarfdump --uuid "$app_dsym" | awk '{ print $2 }' | sort | xargs)"
  [ -n "$app_uuids" ] && [ "$app_uuids" = "$dsym_uuids" ] \
    || die "${app_dsym#"$outdir"/} ($dsym_uuids) does not belong to the app in $ipa ($app_uuids)"

  for dsym in "${candidates[@]}"; do
    matched=0
    for uuid in $(dwarfdump --uuid "$dsym" | awk '{ print $2 }'); do
      if echo "$binaries" | awk -v uuid="$uuid" '$1 != "version" && $2 == uuid { found = 1 } END { exit !found }'; then
        matched=1
      fi
    done
    if [ $matched -eq 1 ]; then
      dsyms+=("$dsym")
    else
      warn "not archiving $(basename "$dsym"): no binary in $ipa has its UUID (left from an earlier build)"
    fi
  done

  dest="$DSYM_ARCHIVE/$version"
  rm -rf "$dest"
  mkdir -p "$dest"
  for dsym in "${dsyms[@]}"; do
    name="$(basename "$dsym")"
    # No resource forks or extended attributes: Xcode's com.apple.provenance would add a ._ entry per file.
    ditto -c -k --norsrc --noextattr --noqtn --noacl --keepParent "$dsym" "$dest/$name.zip.partial"
    mv -f "$dest/$name.zip.partial" "$dest/$name.zip"
  done
  dwarfdump --uuid "${dsyms[@]}" | sed "s|$outdir/||" > "$dest/uuids.txt"
  ARCHIVED_DSYM_DIR="$dest"
  say "dSYMs for build $version ($(size_of "$dest")): $dest"
  awk '$4 ~ /TelegramUIFramework/ { print "TelegramUI UUID " $2 }' "$dest/uuids.txt"
  prune_dsym_archive "$version"
}

# record_build_info <dir> <build> — what the TestFlight changelog needs next time (git log <previous
# build's commit>..<this one>): the build number, commit, branch and dirty/pushed state go next to its dSYMs.
# Warns about a dirty tree, an unpushed commit and unreleased CHANGELOG.md entries (this build's
# entry is then still missing); none of these stops the upload.
record_build_info() {
  local dir="$1" build="$2" commit branch dirty="no" pushed="yes" unreleased
  commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || commit="unknown"
  branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)" || branch="unknown"
  [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ] || dirty="yes"
  # No early-exit reader in a pipeline here: under pipefail its writer would die of SIGPIPE (141) and stop tg.
  [ -n "$(git -C "$ROOT" branch -r --contains "$commit" 2>/dev/null || true)" ] || pushed="no"
  {
    echo "build $build"
    echo "commit $commit"
    echo "branch $branch"
    echo "dirty $dirty"
    echo "pushed $pushed"
  } > "$dir/BUILD-INFO.txt"
  [ "$dirty" = "no" ] || warn "the working tree has uncommitted changes: build $build is not exactly commit ${commit:0:8}"
  [ "$pushed" = "yes" ] || warn "commit ${commit:0:8} is not on any remote branch: the changelog for the next build cannot start from it"
  unreleased="$(awk '/^## Unreleased/ { on = 1; next } /^## / { on = 0 } on && NF { print; exit }' "$ROOT/CHANGELOG.md" 2>/dev/null || true)"
  [ -z "$unreleased" ] || warn "CHANGELOG.md still has Unreleased entries: add this build's entry (build $build, commit ${commit:0:8})"
}

# tg testflight --notes <file> [--export-only] — release build for the App Store with a new build
# number, uploaded to TestFlight through the Apple ID signed in to Xcode (see device_signing.py
# testflight). The build's dSYMs are kept in $DSYM_ARCHIVE/<build number>/ before the upload.
# Every upload gets What to Test notes: <file> is checked before the build, copied next to the
# dSYMs, and set with tools/dev/tf_notes.py once App Store Connect has processed the build
# (waiting at most TG_TF_NOTES_WAIT minutes, default 45). If only that step fails, tg prints
# "UPLOADED; notes not set; run: <command>" and exits 3: the build is uploaded, run the command.
# If App Store Connect rejects the build while processing it, tg prints "build rejected by Apple;
# upload a new build" and exits 4.
# The build carries Enhanced Security (soft mode) on the app, NotificationService and Share: the
# development profiles must grant it (else tg stops before building), and device_signing.py checks
# the exported App Store build and its distribution profiles before the upload, which therefore
# needs the App Store Connect API key (asc/asc.json). TG_TF_ENHANCED_SECURITY=0 ships without it.
cmd_testflight() {
  local notes="" export_only=0 upload_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --notes) [ $# -ge 2 ] || die "usage: tools/dev/tg testflight --notes <file> [--export-only]"
        notes="$2"; shift ;;
      --notes=*) notes="${1#--notes=}" ;;
      --export-only) export_only=1; upload_args+=("$1") ;;
      *) upload_args+=("$1") ;;
    esac
    shift
  done
  if [ $export_only -eq 0 ]; then
    [ -n "$notes" ] || die "every TestFlight upload needs What to Test notes: tools/dev/tg testflight --notes <file>"
    case "$notes" in /*) ;; *) notes="$CALLER_PWD/$notes" ;; esac
    python3 "$ROOT/tools/dev/tf_notes.py" --check "$notes"
  fi

  # Every upload needs a higher build number than the last one.
  export TG_BUILD_NUMBER="${TG_BUILD_NUMBER:-$(date +%Y%m%d%H%M)}"
  if [ "${TG_TF_ENHANCED_SECURITY:-1}" = "0" ]; then
    upload_args+=(--enhanced-security off)
  fi
  cmd_device --no-install --watch --app-store
  archive_dsyms "$ROOT/bazel-bin/Telegram/Telegram.ipa"
  local build="${ARCHIVED_DSYM_DIR##*/}"
  if [ -n "$notes" ]; then
    # The copy outlives a notes file in /tmp, for the command printed below.
    cp "$notes" "$ARCHIVED_DSYM_DIR/WhatToTest.txt"
    notes="$ARCHIVED_DSYM_DIR/WhatToTest.txt"
  fi
  record_build_info "$ARCHIVED_DSYM_DIR" "$build"
  python3 "$ROOT/tools/dev/device_signing.py" testflight "$ROOT/bazel-bin/Telegram/Telegram.ipa" \
    ${upload_args[@]+"${upload_args[@]}"}
  [ $export_only -eq 0 ] || return 0

  local notes_command=(python3 "$ROOT/tools/dev/tf_notes.py" IOS "$build" "$notes")
  say "Setting What to Test notes for $build once App Store Connect has processed it"
  local notes_exit=0
  "${notes_command[@]}" --wait "${TG_TF_NOTES_WAIT:-45}" || notes_exit=$?
  if [ $notes_exit -eq 4 ]; then
    # tf_notes.py: App Store Connect rejected the build (processing FAILED or INVALID).
    printf '\033[31mbuild rejected by Apple; upload a new build\033[0m (build %s, see App Store Connect)\n' "$build" >&2
    exit 4
  fi
  if [ $notes_exit -ne 0 ]; then
    # Exit 3, distinct from a failed build or upload: the build IS on TestFlight, so running
    # tg testflight again would upload a second one. Only the notes command is left to run.
    printf '\033[33mUPLOADED; notes not set; run:\033[0m' >&2
    printf ' %q' "${notes_command[@]}" >&2; printf '\n' >&2
    warn "build $build is uploaded; do not run tg testflight again for it"
    exit 3
  fi
  say "Build $build uploaded with What to Test notes"
}

# tg watch <build|test|project|clean> — the Apple Watch app (Telegram/WatchApp) in the
# watchOS simulator. Uses the dev project (project-dev.yml: the app plus its unit tests),
# regenerated on every run, and fixed DerivedData and SwiftPM directories under
# ~/.cache/telegram-ios/watch, so TDLib (~1.5 GB of SwiftPM checkouts) downloads once.
WATCH_DIR="$ROOT/Telegram/WatchApp"
WATCH_CACHE="${TG_WATCH_CACHE_DIR:-$HOME/.cache/telegram-ios/watch}"

watch_generate() {
  command -v xcodegen >/dev/null || die "xcodegen not found (brew install xcodegen)"
  # Both projects: the committed tgwatch.xcodeproj (Bazel embed build) and the dev one.
  (cd "$WATCH_DIR" && xcodegen generate --quiet && xcodegen generate --quiet --spec project-dev.yml)
}

# TG_WATCH_SIM picks the simulator (UDID or name); otherwise the first available watch.
watch_simulator() {
  if [ -n "${TG_WATCH_SIM:-}" ]; then echo "$TG_WATCH_SIM"; return; fi
  xcrun simctl list devices available -j | python3 -c '
import json, sys
runtimes = json.load(sys.stdin)["devices"]
for runtime in sorted((r for r in runtimes if ".watchOS-" in r), reverse=True):
    for device in runtimes[runtime]:
        print(device["udid"]); sys.exit(0)
sys.exit(1)' || die "no watchOS simulator (create one in Xcode, or set TG_WATCH_SIM)"
}

# watch_xcodebuild <action...> [-- extra xcodebuild args]
watch_xcodebuild() {
  local sim dest
  sim="$(watch_simulator)"
  if [[ "$sim" =~ ^[0-9A-F-]{36}$ ]]; then dest="id=$sim"; else dest="name=$sim"; fi
  mkdir -p "$WATCH_CACHE"
  say "watchOS simulator $sim, DerivedData $WATCH_CACHE/DerivedData"
  # No api credentials: the app builds and its tests run, but it cannot log in.
  xcodebuild "$@" \
    -project "$WATCH_DIR/tgwatch-dev.xcodeproj" \
    -scheme "tgwatch Watch App" \
    -destination "platform=watchOS Simulator,$dest" \
    -derivedDataPath "$WATCH_CACHE/DerivedData" \
    -clonedSourcePackagesDirPath "$WATCH_CACHE/SourcePackages" \
    -quiet \
    TG_API_ID=0 TG_API_HASH=placeholder
}

cmd_watch() {
  local sub="${1:-help}"; shift || true
  [ "${1:-}" != "--" ] || shift
  case "$sub" in
    build) watch_generate; watch_xcodebuild build "$@"
      say "Built: $WATCH_CACHE/DerivedData/Build/Products/Debug-watchsimulator/tgwatch Watch App.app" ;;
    test) watch_generate; watch_xcodebuild test "$@"; say "Watch tests passed" ;;
    project) watch_generate
      say "Generated tgwatch.xcodeproj (Bazel embed) and tgwatch-dev.xcodeproj (with tests)"
      [ "${1:-}" = "--no-open" ] || open "$WATCH_DIR/tgwatch-dev.xcodeproj" ;;
    clean) rm -rf "$WATCH_CACHE/DerivedData"; say "Removed $WATCH_CACHE/DerivedData (SwiftPM checkouts kept)" ;;
    *) die "usage: tools/dev/tg watch <build|test|project|clean> (see: tools/dev/tg help)" ;;
  esac
}

