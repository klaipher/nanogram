  watch project [--no-open]  Regenerate the watch app's Xcode projects and open the dev one
  watch clean           Remove the watch app's DerivedData, keep its SwiftPM checkouts

Environment: TG_CACHE_DIR, TG_CONFIG, TG_CODESIGNING, TG_BUILD_NUMBER,
             TG_WATCH_SIM, TG_WATCH_CACHE_DIR,
             TG_DSYM_DIR (default: ~/Library/Application Support/Nanogram/dsyms),
             TG_DSYM_KEEP (0 = keep every build's dSYMs, the default; N = keep the N highest build numbers),
             TG_TF_NOTES_WAIT (minutes tg testflight waits for processing, default 45)
EOF
}

# tg perf run [--package DIR ...] | check | record | model [perfgate options]: the performance tests that need no app
# (docs/profiling.md, "Tests that measure"). `run` runs the *PerformanceTests of the SwiftPM packages (default: Postbox)
# on this machine with TG_PERF=1 and compares the numbers with tools/dev/perf/baselines.json (tools/dev/perfgate.py);
# a missing baseline is recorded on the owner's devices, never a failure. The other performance tests are Bazel
# ios_unit_tests (ChatListUITests, DisplayTests, TextFormatTests); run them with TG_PERF=1 in the test environment and
# pass their test.log to `tg perf check --log FILE --suite ios-sim`. Not part of the pre-push gate.
cmd_perf() {
  local sub="${1:-}"
  case "$sub" in
    check|record|model) python3 "$ROOT/tools/dev/perfgate.py" "$@" ;;
    run)
      shift
      local packages=() gate_args=() log package
      while [ $# -gt 0 ]; do
        case "$1" in
          --package) [ $# -ge 2 ] || die "--package needs a directory"; packages+=("$2"); shift ;;
          *) gate_args+=("$1") ;;
        esac
        shift
      done
      [ ${#packages[@]} -gt 0 ] || packages=(submodules/Postbox)
      log="$(mktemp -t tg-perf.XXXXXX)"
      for package in "${packages[@]}"; do
        say "Performance tests in $package"
        TG_PERF=1 swift test --package-path "$ROOT/$package" --filter PerformanceTests 2>&1 | tee -a "$log"
      done
      python3 "$ROOT/tools/dev/perfgate.py" check --suite swift-host --log "$log" ${gate_args[@]+"${gate_args[@]}"}
      ;;
    *) die "usage: tools/dev/tg perf run [--package DIR ...] [perfgate options] | check|record|model [perfgate options]" ;;
  esac
}

