#!/usr/bin/env bash
# tg — local development helper for this Telegram-iOS fork.
#
# Wraps build-system/Make/Make.py with fast, disk-friendly defaults for
# simulator work. Run `tools/dev/tg help` for commands; see
# docs/local-development.md for the reasoning behind each default.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

CACHE_DIR="${TG_CACHE_DIR:-$HOME/.cache/telegram-ios/bazel-disk-cache}"
CONFIG="${TG_CONFIG:-$ROOT/build-system/dev-configuration.json}"
CODESIGNING="${TG_CODESIGNING:-$ROOT/build-system/fake-codesigning}"
UPSTREAM_URL="https://github.com/TelegramMessenger/Telegram-iOS.git"

bazel_version() { python3 -c 'import json;print(json.load(open("versions.json"))["bazel"].split(":")[0])'; }
xcode_version() { python3 -c 'import json;print(json.load(open("versions.json"))["xcode"])'; }
bazel_bin() { echo "$ROOT/build-input/bazel-$(bazel_version)-darwin-$(uname -m)"; }

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

size_of() { if [ -e "$1" ]; then du -sh "$1" 2>/dev/null | cut -f1; else echo "-"; fi; }

require_config() {
  [ -f "$CONFIG" ] || die "no build configuration at $CONFIG. Run: tools/dev/tg setup"
}

# Make.py checks Xcode against versions.json; upstream's own dev command always
# overrides it, so do the same and let `doctor` report a mismatch instead.
make_py() {
  python3 -u build-system/Make/Make.py --overrideXcodeVersion --cacheDir="$CACHE_DIR" "$@"
}

cmd_setup() {
  say "Configuring git for a large repository"
  git config core.untrackedCache true
  git config feature.manyFiles true
  git config fetch.parallel 0
  git config submodule.fetchJobs 0
  # Built-in FSEvents monitor (git >= 2.37) keeps `git status` fast on ~49k files.
  # (`git help -a` hides double-dash commands, so probe the daemon directly.)
  if ! git fsmonitor--daemon status 2>&1 | grep 'not a git command' >/dev/null; then
    git config core.fsmonitor true
  fi

  say "Fetching submodules (shallow)"
  git submodule sync --recursive >/dev/null
  git submodule update --init --recursive --depth 1 --jobs 8

  mkdir -p "$CACHE_DIR"

  if [ ! -f "$CONFIG" ]; then
    cp build-system/appstore-configuration.json "$CONFIG"
    say "Created $CONFIG from appstore-configuration.json"
    warn "Replace api_id and api_hash in it with your own (https://my.telegram.org/apps)."
    warn "Keep bundle_id/team_id unless you also provide matching provisioning profiles."
  fi

  if [ ! -f user.bazelrc ]; then
    cat > user.bazelrc <<EOF
# Personal Bazel settings (not checked in). Examples:
# common --experimental_disk_cache_gc_max_size=20G
# build --jobs=8
EOF
    say "Created user.bazelrc for personal overrides"
  fi

  cmd_doctor || true
}

cmd_doctor() {
  local ok=0
  local want_xcode; want_xcode="$(xcode_version)"
  # Ignore DEVELOPER_DIR: Bazel runs the third-party genrules (webp, ffmpeg, ...)
  # without it, and they call xcode-select themselves.
  local dev_dir; dev_dir="$(env -u DEVELOPER_DIR xcode-select -p 2>/dev/null || true)"
  if [[ "$dev_dir" != *Xcode*.app* ]]; then
    warn "xcode-select points at '$dev_dir'. Install Xcode $want_xcode and run: sudo xcode-select -s /Applications/Xcode.app"
    ok=1
  else
    local have; have="$(xcodebuild -version 2>/dev/null | awk 'NR==1{print $2}')"
    if [ "$have" != "$want_xcode" ]; then
      warn "Xcode $have is selected, this release expects $want_xcode (versions.json). Builds may fail."
      ok=1
    else
      say "Xcode $have"
    fi
    # Xcode 26+ ships the Metal compiler as a separate download; the app's shaders need it.
    if ! xcrun metal --version >/dev/null 2>&1; then
      warn "Metal Toolchain missing. Run: xcodebuild -downloadComponent MetalToolchain"
      ok=1
    fi
  fi
  [ -f "$CONFIG" ] && say "Configuration: $CONFIG" || { warn "Missing $CONFIG (run: tools/dev/tg setup)"; ok=1; }
  if git submodule status --recursive | grep '^-' >/dev/null; then
    warn "Some submodules are not checked out (run: tools/dev/tg setup)"; ok=1
  fi
  local free; free="$(df -g "$ROOT" | awk 'NR==2{print $4}')"
  if [ "${free:-0}" -lt 60 ]; then
    warn "Only ${free} GB free. A first full debug build needs roughly 40-60 GB (output base + disk cache)."
    ok=1
  else
    say "Free disk: ${free} GB"
  fi
  local expires
  expires="$(security cms -D -i "$ROOT/build-system/fake-codesigning/profiles/Telegram.mobileprovision" 2>/dev/null \
    | plutil -extract ExpirationDate raw - 2>/dev/null || true)"
  if [ -n "$expires" ] && [ "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \> "$expires" ]; then
    warn "The fake provisioning profiles expired on $expires, so device builds fail (run: tools/dev/tg refresh-fake-profiles)"
    ok=1
  fi
  return $ok
}

# tg build [--release] [--device] [--full] [-- extra Make.py build args]
cmd_build() {
  require_config
  local configuration full=0 bazel_args=() extra=()
  local release=0 device=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) release=1 ;;
      --device) device=1 ;;
      --full) full=1 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown build option: $1" ;;
    esac
    shift
  done
  case "$release$device" in
    00) configuration=debug_sim_arm64 ;;
    10) configuration=release_sim_arm64 ;;
    01) configuration=debug_arm64 ;;
    11) configuration=release_arm64 ;;
  esac
  # The app extensions (Share, Notification Service/Content, Intents, Widget)
  # are separate binaries that most UI work never touches.
  if [ $full -eq 0 ]; then bazel_args+=("--//Telegram:disableExtensions"); fi
  if [ $device -eq 1 ] && security show-keychain-info "$FAKE_KEYCHAIN" >/dev/null 2>&1; then
    security unlock-keychain -p "" "$FAKE_KEYCHAIN" 2>/dev/null || true
  fi
  if [ $device -eq 0 ]; then
    # Simulator builds need no provisioning profiles, and nothing installs them
    # from an .ipa: output Telegram.app as a directory instead of zipping the whole
    # bundle into Telegram.ipa on every build.
    bazel_args+=("--//Telegram:disableProvisioningProfiles")
    bazel_args+=("--define=apple.experimental.tree_artifact_outputs=1")
  fi
  # Debug builds: line tables only for third-party C/C++ (WebRTC alone is ~3,000
  # files). Backtraces keep file and line numbers; stepping through variables in
  # those libraries needs `tg build -- --bazelArguments=...` without it. Smaller
  # objects, less disk, faster compiles. Telegram's own code keeps full debug info.
  if [ $release -eq 0 ]; then bazel_args+=("--per_file_copt=^third-party/.*@-gline-tables-only"); fi

  local make_args=()
  if [ ${#bazel_args[@]} -gt 0 ]; then
    make_args+=("--bazelArguments=${bazel_args[*]}")
  fi
  # ${a[@]+"${a[@]}"}: empty arrays are "unbound" under set -u in macOS bash 3.2.
  make_py ${make_args[@]+"${make_args[@]}"} build \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    --buildNumber="${TG_BUILD_NUMBER:-1}" \
    --configuration="$configuration" \
    ${extra[@]+"${extra[@]}"}
  if [ $device -eq 0 ]; then
    say "Built: $ROOT/bazel-bin/Telegram/Telegram.app"
  else
    say "Built: $ROOT/bazel-bin/Telegram/Telegram.ipa"
  fi
}

# tg run [build options] — build for the simulator, install and launch it on the
# test simulator (build-system/bazel-utils/test_simulator.bzl), creating and
# booting that simulator if needed.
cmd_run() {
  cmd_build "$@"
  local device os bundle_id udid app_path installed
  device="$(sed -n 's/^TEST_SIMULATOR_DEVICE = "\(.*\)"$/\1/p' build-system/bazel-utils/test_simulator.bzl)"
  os="$(sed -n 's/^TEST_SIMULATOR_OS = "\(.*\)"$/\1/p' build-system/bazel-utils/test_simulator.bzl)"
  bundle_id="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["bundle_id"])' "$CONFIG")"
  udid="$(xcrun simctl list devices "iOS $os" | sed -n "s/^ *$device (\([0-9A-F-]*\)).*/\1/p" | head -1)"
  if [ -z "$udid" ]; then
    udid="$(xcrun simctl create "$device" "com.apple.CoreSimulator.SimDeviceType.${device// /-}" \
      "com.apple.CoreSimulator.SimRuntime.iOS-${os//./-}")"
  fi
  xcrun simctl bootstatus "$udid" -b >/dev/null
  # Show the device window: Simulator.app in older Xcodes, DeviceHub in Xcode 27.
  local dev_dir; dev_dir="$(env -u DEVELOPER_DIR xcode-select -p)"
  if [ -d "$dev_dir/Applications/Simulator.app" ]; then
    open "$dev_dir/Applications/Simulator.app" --args -CurrentDeviceUDID "$udid" || true
  else
    open "$dev_dir/../Applications/DeviceHub.app" || true
  fi
  [ -x "$ROOT/bazel-bin/Telegram/Telegram.app/Telegram" ] || die "no app at $ROOT/bazel-bin/Telegram/Telegram.app"
  # Bazel outputs are read-only and simctl needs a writable bundle: stage an APFS
  # clone (instant, no extra space) and install from that.
  local stage; stage="$(mktemp -d)"
  app_path="$stage/Telegram.app"
  cp -Rc "$ROOT/bazel-bin/Telegram/Telegram.app" "$app_path" && chmod -R u+w "$app_path"
  xcrun simctl terminate "$udid" "$bundle_id" 2>/dev/null || true
  # `simctl install` keeps the old binary when the build number is unchanged, so
  # replace an installed bundle in place (the data container is separate).
  installed="$(xcrun simctl get_app_container "$udid" "$bundle_id" app 2>/dev/null || true)"
  if [ -n "$installed" ] && [ -d "$installed" ]; then
    rm -rf "$installed" && cp -Rp "$app_path" "$installed"
  else
    xcrun simctl install "$udid" "$app_path"
  fi
  rm -rf "$stage"
  xcrun simctl launch "$udid" "$bundle_id" >/dev/null
  say "Running on $device (iOS $os, $udid)"
}

# tg project [--full] — generate and open the Xcode project (simulator, no extensions).
cmd_project() {
  require_config
  local args=(--disableProvisioningProfiles)
  [ "${1:-}" = "--full" ] || args+=(--disableExtensions)
  make_py generateProject \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    "${args[@]}"
}

# tg test [label]
cmd_test() {
  require_config
  make_py test \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    ${1:+--target="$1"}
}

FAKE_KEYCHAIN="telegram-fake-codesigning.keychain-db"

# tg fake-signing [--remove] — put the public fake signing identity from
# build-system/fake-codesigning/certs into its own keychain, so `tg build --device`
# can sign with the fake profiles (the result compiles, links and signs, but cannot
# be installed on a phone). The keychain has an empty password and never locks on
# its own; --remove deletes it again.
cmd_fake_signing() {
  if [ "${1:-}" = "--remove" ]; then
    security delete-keychain "$FAKE_KEYCHAIN" 2>/dev/null || true
    say "Removed $FAKE_KEYCHAIN"
    return 0
  fi
  if ! security show-keychain-info "$FAKE_KEYCHAIN" >/dev/null 2>&1; then
    security create-keychain -p "" "$FAKE_KEYCHAIN"
  fi
  security set-keychain-settings "$FAKE_KEYCHAIN"
  security unlock-keychain -p "" "$FAKE_KEYCHAIN"
  security import "$ROOT/build-system/fake-codesigning/certs/SelfSigned.p12" -k "$FAKE_KEYCHAIN" -P "" \
    -T /usr/bin/codesign -T /usr/bin/security >/dev/null 2>&1 || true
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "" "$FAKE_KEYCHAIN" >/dev/null
  local current
  current="$(security list-keychains -d user | tr -d '"' | xargs)"
  case " $current " in
    *"/$FAKE_KEYCHAIN "*) ;;
    *) eval "security list-keychains -d user -s $current \"\$HOME/Library/Keychains/$FAKE_KEYCHAIN\"" ;;
  esac
  security find-identity -p codesigning "$FAKE_KEYCHAIN" | sed -n '1,3p'
  say "Fake signing identity installed in $FAKE_KEYCHAIN"
}

# tg new-module <dir> — scaffold a Swift module that uses the strict Swift preset
# (build-system/bazel-utils/swift_strict.bzl) and a host unit test, then run the test.
cmd_new_module() {
  local path="${1:-}"
  [ -n "$path" ] || die "usage: tools/dev/tg new-module <dir>   (e.g. submodules/MyFeature)"
  path="${path%/}"
  local name; name="$(basename "$path")"
  [[ "$name" =~ ^[A-Z][A-Za-z0-9]*$ ]] || die "the directory name is the module name and must be UpperCamelCase: $name"
  [ ! -e "$path" ] || die "$path already exists"
  mkdir -p "$path/Sources" "$path/Tests"
  cat > "$path/BUILD" <<EOF
load("//build-system/bazel-utils:swift_strict.bzl", "strict_swift_library", "strict_swift_test")

strict_swift_library(
    name = "$name",
    module_name = "$name",
    srcs = glob(["Sources/**/*.swift"]),
    deps = [],
    visibility = ["//visibility:public"],
)

# Runs on the Mac (tools/dev/tg new-module ran it once). Keep it while the module
# needs only Foundation; a module that imports UIKit needs an ios_unit_test instead.
strict_swift_test(
    name = "${name}Tests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":$name"],
)
EOF
  cat > "$path/Sources/$name.swift" <<EOF
public enum $name {
    public static let name = "$name"
}
EOF
  cat > "$path/Tests/${name}Tests.swift" <<EOF
import XCTest
@testable import $name

final class ${name}Tests: XCTestCase {
    func testName() {
        XCTAssertEqual($name.name, "$name")
    }
}
EOF
  say "Created $path (strict Swift 6). Checking that it builds and its test passes"
  "$(bazel_bin)" test "//$path:${name}Tests" --test_output=errors
  say "Add \"//$path\" to the deps of the module that uses it"
}

# tg strict-report — count Swift 6 concurrency problems per module.
#
# Builds the app once with -strict-concurrency=complete, reporting every problem as
# a warning so the whole tree is checked in one pass. It rebuilds all Swift code
# (about 15 minutes) and replaces the normal build outputs; the next `tg build`
# restores them from the disk cache, which this build does not write to.
cmd_strict_report() {
  require_config
  local dir; dir="$(dirname "$CACHE_DIR")"
  local log="$dir/strict-report.log" report="$dir/strict-report.txt"
  mkdir -p "$dir"
  say "Building with Swift 6 concurrency checking (log: $log)"
  local flags="--//Telegram:disableExtensions --//Telegram:disableProvisioningProfiles"
  flags+=" --@build_bazel_rules_swift//swift:copt=-strict-concurrency=complete"
  flags+=" --@build_bazel_rules_swift//swift:copt=-no-warnings-as-errors"
  flags+=" --disk_cache= --experimental_ui_max_stdouterr_bytes=-1"
  make_py "--bazelArguments=$flags" build --continueOnError \
    --configurationPath="$CONFIG" \
    --codesigningInformationPath="$CODESIGNING" \
    --buildNumber=1 --configuration=debug_sim_arm64 >"$log" 2>&1 || true
  python3 "$ROOT/build-system/Make/StrictReport.py" "$ROOT" "$log" "$(bazel_bin)" | tee "$report"
  say "Report saved to $report. Run tools/dev/tg build to restore the normal outputs"
}

cmd_disk() {
  local bazel; bazel="$(bazel_bin)"
  printf '%-34s %s\n' "Source checkout (incl. .git)" "$(size_of "$ROOT")"
  printf '%-34s %s\n' "  .git (+ submodule objects)" "$(size_of "$ROOT/.git")"
  printf '%-34s %s\n' "Bazel disk cache ($CACHE_DIR)" "$(size_of "$CACHE_DIR")"
  if [ -x "$bazel" ]; then
    local output_base repo_cache
    output_base="$("$bazel" info output_base 2>/dev/null || true)"
    repo_cache="$("$bazel" info repository_cache 2>/dev/null || true)"
    printf '%-34s %s\n' "Bazel output base" "$(size_of "$output_base")"
    printf '%-34s %s\n' "  Xcode project builds (nested)" "$(size_of "$output_base/rules_xcodeproj.noindex")"
    printf '%-34s %s\n' "Bazel repository cache" "$(size_of "$repo_cache")"
  else
    echo "Bazel output base                  (bazel not downloaded yet)"
  fi
  local dd=( "$HOME"/Library/Developer/Xcode/DerivedData/Telegram-* )
  if [ -e "${dd[0]}" ]; then
    printf '%-34s %s\n' "Xcode DerivedData (Telegram-*)" "$(du -shc "${dd[@]}" | tail -1 | cut -f1)"
  fi
}

# tg clean — drop build outputs, keep downloaded repositories and the disk cache.
cmd_clean() {
  local bazel; bazel="$(bazel_bin)"
  [ -x "$bazel" ] || die "bazel not downloaded yet"
  "$bazel" clean
}

# tg prune [--yes] — reclaim everything Bazel and Xcode keep for this checkout.
cmd_prune() {
  if [ "${1:-}" != "--yes" ]; then
    echo "This deletes the Bazel output base (bazel clean --expunge), the disk cache at"
    echo "$CACHE_DIR and Telegram-* DerivedData. The next build starts cold."
    echo "Re-run with: tools/dev/tg prune --yes"
    return 1
  fi
  local bazel; bazel="$(bazel_bin)"
  if [ -x "$bazel" ]; then "$bazel" clean --expunge; fi
  rm -rf "$CACHE_DIR"
  rm -rf "$HOME"/Library/Developer/Xcode/DerivedData/Telegram-*
  say "Pruned"
}

# tg sync-upstream <tag> — import an official release onto the `upstream` branch.
cmd_sync_upstream() {
  local tag="${1:-}"
  [ -n "$tag" ] || die "usage: tools/dev/tg sync-upstream <tag>   (e.g. release-13.2)"
  git remote get-url telegram >/dev/null 2>&1 || git remote add telegram "$UPSTREAM_URL"
  say "Fetching $tag (depth 1)"
  git fetch --depth 1 --no-tags telegram "refs/tags/$tag:refs/telegram-tags/$tag"
  local commit tree parent new
  commit="$(git rev-parse "refs/telegram-tags/$tag^{commit}")"
  tree="$(git rev-parse "$commit^{tree}")"
  parent="$(git rev-parse upstream)"
  if [ "$(git rev-parse "upstream^{tree}")" = "$tree" ]; then
    say "upstream already matches $tag"; return 0
  fi
  new="$(git commit-tree "$tree" -p "$parent" -m "Import upstream Telegram-iOS $tag

Snapshot of $UPSTREAM_URL at tag $tag (commit $commit), imported without history.

Upstream-Tag: $tag
Upstream-Commit: $commit")"
  git update-ref refs/heads/upstream "$new" "$parent"
  say "upstream -> $tag ($(git rev-parse --short "$new")). Next:"
  echo "  git switch main && git merge upstream"
  echo "  git submodule update --init --recursive --depth 1 --jobs 8"
}

# tg device [--no-install] — release build signed for your own iPhone, then install it.
# Uses ~/.config/telegram-ios/device-configuration.json (bundle id, team, your api_id) and the
# profiles that `python3 tools/dev/device_signing.py profiles` puts in
# ~/.config/telegram-ios/codesigning (paid team: push and app extensions). Without those
# profiles it falls back to Xcode's free signing, which has no push and no extensions.
cmd_device() {
  local config="${TG_DEVICE_CONFIG:-$HOME/.config/telegram-ios/device-configuration.json}"
  local signing="${TG_DEVICE_CODESIGNING:-$HOME/.config/telegram-ios/codesigning}"
  local install=1 udid="${TG_DEVICE_UDID:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-install) install=0 ;;
      *) die "unknown device option: $1" ;;
    esac
    shift
  done
  [ -f "$config" ] || die "no device configuration at $config"

  local signing_args=() make_args=()
  if ls "$signing/profiles/"*.mobileprovision >/dev/null 2>&1; then
    signing_args=(--codesigningInformationPath="$signing")
  else
    warn "no profiles in $signing/profiles (run: python3 tools/dev/device_signing.py profiles)"
    warn "using free Xcode signing: no push notifications, no app extensions"
    signing_args=(--xcodeManagedCodesigning)
    make_args=("--bazelArguments=--//Telegram:disableExtensions")
  fi
  make_py ${make_args[@]+"${make_args[@]}"} build \
    --configurationPath="$config" \
    "${signing_args[@]}" \
    --buildNumber="${TG_BUILD_NUMBER:-1}" \
    --configuration=release_arm64
  say "Built: $ROOT/bazel-bin/Telegram/Telegram.ipa"
  [ $install -eq 1 ] || return 0

  if [ -z "$udid" ]; then
    udid="$(xcrun devicectl list devices 2>/dev/null | awk '/physical/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9A-F]{8}-[0-9A-F]{16}$/) { print $i; exit } }')"
  fi
  [ -n "$udid" ] || die "no iPhone found: connect it (cable or same Wi-Fi) and unlock it, or set TG_DEVICE_UDID"
  local unpacked
  unpacked="$(mktemp -d)"
  unzip -q "$ROOT/bazel-bin/Telegram/Telegram.ipa" -d "$unpacked"
  # The phone sometimes rejects a valid signature once (0xe8008001); a second attempt installs.
  xcrun devicectl device install app --device "$udid" "$unpacked/Payload/Telegram.app" \
    || xcrun devicectl device install app --device "$udid" "$unpacked/Payload/Telegram.app"
  rm -rf "$unpacked"
  say "Installed on $udid"
}

# tg testflight — release build for the App Store with a new build number, uploaded to
# TestFlight through the Apple ID signed in to Xcode (see device_signing.py testflight).
cmd_testflight() {
  # Every upload needs a higher build number than the last one.
  export TG_BUILD_NUMBER="${TG_BUILD_NUMBER:-$(date +%Y%m%d%H%M)}"
  cmd_device --no-install
  python3 "$ROOT/tools/dev/device_signing.py" testflight "$ROOT/bazel-bin/Telegram/Telegram.ipa" "$@"
}

cmd_help() {
  cat <<'EOF'
Usage: tools/dev/tg <command> [options]

  setup                 Configure git, fetch submodules shallowly, create local config files
  doctor                Check Xcode version, configuration, submodules and free disk
  build [--release] [--device] [--full] [-- <Make.py build args>]
                        Build the app (default: debug simulator, no app extensions)
  run [build options]   Build, install and launch on the test simulator
  device [--no-install] Release build signed for your iPhone, then install it
                        (signing: python3 tools/dev/device_signing.py --help)
  testflight [--export-only]  Release build uploaded to TestFlight (new build number)
  project [--full]      Generate and open the Xcode project (simulator, no extensions)
  test [label]          Run tests (default: Tests/AllTests)
  new-module <dir>      Create a Swift module that uses the strict Swift 6 preset
  strict-report         Count Swift 6 concurrency problems per module (~15 min)
  refresh-fake-profiles Re-date and re-sign the fake provisioning profiles (device builds)
  fake-signing [--remove]  Install (or remove) the fake signing identity for device builds
  disk                  Show what is using disk space
  clean                 Remove build outputs, keep downloads and caches
  prune [--yes]         Remove all Bazel outputs, the disk cache and DerivedData
  sync-upstream <tag>   Import an official release tag onto the `upstream` branch

Environment: TG_CACHE_DIR, TG_CONFIG, TG_CODESIGNING, TG_BUILD_NUMBER
EOF
}

command="${1:-help}"; shift || true
case "$command" in
  setup) cmd_setup "$@" ;;
  doctor) cmd_doctor "$@" ;;
  build) cmd_build "$@" ;;
  run) cmd_run "$@" ;;
  device) cmd_device "$@" ;;
  testflight) cmd_testflight "$@" ;;
  fake-signing) cmd_fake_signing "$@" ;;
  project) cmd_project "$@" ;;
  test) cmd_test "$@" ;;
  new-module) cmd_new_module "$@" ;;
  strict-report) cmd_strict_report "$@" ;;
  refresh-fake-profiles) python3 "$ROOT/build-system/Make/RefreshFakeProfiles.py" "$@" ;;
  disk) cmd_disk "$@" ;;
  clean) cmd_clean "$@" ;;
  prune) cmd_prune "$@" ;;
  sync-upstream) cmd_sync_upstream "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $command (see: tools/dev/tg help)" ;;
esac
