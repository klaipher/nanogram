#!/usr/bin/env bash
# git pre-push hook: lint the pushed lines, then run the tests of the modules they touch.
# Install with: python3 tools/dev/lint/tglint.py install-hook
# Skip once: git push --no-verify. Lint only: TG_PRE_PUSH_TESTS=0 git push
set -euo pipefail
exec python3 "$(dirname "${BASH_SOURCE[0]}")/tglint.py" pre-push "$@"
