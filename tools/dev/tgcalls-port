#!/usr/bin/env bash
# tgcalls-port — carry shared tgcalls commits from the iOS branch to the Mac branch.
#
# The iOS app pins klaipher/tgcalls branch telegram-ios-dev and the Mac app pins nanogram-mac-integration.
# They share most of the engine (calls, group calls, livestreams, darwin capture/encode/decode), so a fix in
# shared code is only half done until it is on both. This applies the given commits (oldest first) to the
# Mac branch in a scratch worktree with `git cherry-pick -x`, on a local branch mac-port/<name>, and says
# which ones applied and which conflicted. It never pushes and never touches the Mac checkout or its pin;
# review the branch, then fast-forward nanogram-mac-integration and update the Mac pin yourself.
#
#   tools/dev/tgcalls-port <commit>...          e.g. tools/dev/tgcalls-port d3eaad3 cc17523
#   tools/dev/tgcalls-port --range <a>..<b>     every commit in the range
#   tools/dev/tgcalls-port --status             commits on telegram-ios-dev that are not on the Mac branch yet
#
# Guard iOS-only code with TARGET_OS_IOS / WEBRTC_IOS so the Mac build stays correct. Environment:
# TGCALLS_MAC_REF (default macrepo/nanogram-mac-integration), TGCALLS_IOS_REF (default telegram-ios-dev).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TG="$ROOT/submodules/TgVoipWebrtc/tgcalls"
MAC_REF="${TGCALLS_MAC_REF:-macrepo/nanogram-mac-integration}"
IOS_REF="${TGCALLS_IOS_REF:-telegram-ios-dev}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[ -e "$TG/.git" ] || die "the tgcalls submodule is not checked out at $TG"
cd "$TG"

if git remote | grep -qx macrepo; then
  git fetch --quiet macrepo || die "could not fetch macrepo"
fi
git rev-parse --verify --quiet "$MAC_REF" >/dev/null || die "no ref $MAC_REF (add the remote: git -C $TG remote add macrepo https://github.com/klaipher/tgcalls)"

if [ "${1:-}" = "--status" ]; then
  echo "On $IOS_REF, not yet on $MAC_REF (by patch id, so a cherry-picked commit counts as carried):"
  git log --oneline --cherry-pick --right-only --no-merges "$MAC_REF...$IOS_REF"
  exit 0
fi

commits=()
if [ "${1:-}" = "--range" ]; then
  [ -n "${2:-}" ] || die "--range needs <a>..<b>"
  while read -r c; do commits+=("$c"); done < <(git rev-list --reverse --no-merges "$2")
else
  [ $# -gt 0 ] || die "usage: tools/dev/tgcalls-port <commit>... | --range a..b | --status"
  commits=("$@")
fi

name="mac-port/$(date +%Y%m%d-%H%M%S)-$$"
work="$(mktemp -d "${TMPDIR:-/tmp}/tgcalls-mac-port.XXXXXX")"
git worktree add -q -b "$name" "$work" "$MAC_REF"
applied=(); conflicted=""
for c in "${commits[@]}"; do
  if git -C "$work" cherry-pick -x "$c" >/dev/null 2>&1; then
    applied+=("$c")
  else
    conflicted="$c"
    echo "conflict in $c ($(git -C "$work" log -1 --format=%s "$c")):" >&2
    git -C "$work" diff --name-only --diff-filter=U | sed 's/^/  /' >&2
    git -C "$work" cherry-pick --abort >/dev/null 2>&1 || true
    break
  fi
done

echo "branch $name in $work"
echo "applied: ${#applied[@]} of ${#commits[@]}"
for c in ${applied[@]+"${applied[@]}"}; do echo "  ok       $(git log -1 --format='%h %s' "$c")"; done
if [ -n "$conflicted" ]; then
  echo "  CONFLICT $(git log -1 --format='%h %s' "$conflicted")"
  echo "resolve it by hand in $work (git cherry-pick -x $conflicted), then continue with the rest."
  exit 2
fi
echo "next: review $work, run the Mac host tests (submodules/TgVoipWebrtc/tgcalls/tests/*/run.sh), then move the Mac branch and its pin."
