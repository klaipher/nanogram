# Nanogram's watch app (also builds tlottie from submodules/tlottie, see Telegram/prebuilt_watchos.bzl), built by //Telegram:TelegramWatchApp (apple_prebuilt_watchos_application)
# via xcodebuild. These files are the compile action's inputs, so the watch build re-runs only
# when one of them changes. The development project, its spec and the app's unit tests are not
# part of the embedded build (prebuilt_watchos_compile.sh does not copy them either).
filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.build/**",
            "**/.swiftpm/**",
            "**/xcuserdata/**",
            "**/DerivedData/**",
            # Generated by tools/build-tlottie-xcframework.sh inside the compile action, never an input.
            "Packages/TLottieKit/Frameworks/**",
            "BUILD",
            ".gitignore",
            "Tests/**",
            "project-dev.yml",
            "tgwatch-dev.xcodeproj/**",
            # The Xcode automatic-signing variant is not part of the embedded build (the widget extension is).
            "project-widget.yml",
            "tgwatch-widget.xcodeproj/**",
            "WatchWidget/OWNER-STEPS.md",
        ],
    ),
    visibility = ["//Telegram:__pkg__"],
)

# The App Group entitlements of the app and the widget extension. prebuilt_watchos_patch.sh signs with them when no
# provisioning profile is given (an App Store export keeps them when it re-signs).
filegroup(
    name = "entitlements",
    srcs = [
        "WatchWidget/WatchApp.entitlements",
        "WatchWidget/WatchWidget.entitlements",
    ],
    visibility = ["//Telegram:__pkg__"],
)
