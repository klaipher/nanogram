# Submodules are fetched shallow (shallow = true): only the pinned commit, not
# the full history (~400 MB more for webrtc, libvpx and td alone). Relative URLs
# were made absolute so they resolve to TelegramMessenger from this fork too.
[submodule "submodules/TgVoipWebrtc/tgcalls"]
	path = submodules/TgVoipWebrtc/tgcalls
	url = https://github.com/klaipher/tgcalls.git
	shallow = true
	branch = nanogram-shared
[submodule "third-party/libvpx/libvpx"]
	path = third-party/libvpx/libvpx
	url = https://github.com/webmproject/libvpx.git
	shallow = true
[submodule "third-party/webrtc/webrtc"]
	path = third-party/webrtc/webrtc
	url = https://github.com/klaipher/webrtc.git
	shallow = true
	branch = nanogram
[submodule "third-party/dav1d/dav1d"]
	path = third-party/dav1d/dav1d
	url = https://code.videolan.org/videolan/dav1d.git
	shallow = true
[submodule "third-party/td/td"]
	path = third-party/td/td
	url = https://github.com/tdlib/td
	shallow = true
[submodule "third-party/wallet-engine"]
	path = third-party/wallet-engine/wallet-engine
	url = https://github.com/klaipher/wallet-engine.git
	shallow = true
	branch = nanogram
[submodule "submodules/tlottie/tlottie"]
	path = submodules/tlottie/tlottie
	url = https://github.com/dkaraush/tlottie.git
	shallow = true
[submodule "third-party/mtproto-engine"]
	path = third-party/mtproto-engine
	url = https://github.com/TelegramMessenger/mtproto-engine.git
	shallow = true
[submodule "submodules/ffmpeg/Sources/FFMpeg/ffmpeg-9.0.2"]
	path = submodules/ffmpeg/Sources/FFMpeg/ffmpeg-9.0.2
	url = https://github.com/klaipher/FFmpeg.git
	branch = nanogram
	shallow = true
[submodule "third-party/boost_regex/regex"]
	path = third-party/boost_regex/regex
	url = https://github.com/boostorg/regex.git
	shallow = true
[submodule "third-party/wamr/wamr"]
	path = third-party/wamr/wamr
	url = https://github.com/bytecodealliance/wasm-micro-runtime.git
	shallow = true
[submodule "third-party/ogg/ogg"]
	path = third-party/ogg/ogg
	url = https://github.com/xiph/ogg.git
	shallow = true
[submodule "third-party/opusfile/opusfile"]
	path = third-party/opusfile/opusfile
	url = https://github.com/xiph/opusfile.git
	shallow = true
[submodule "third-party/webp/libwebp"]
	path = third-party/webp/libwebp
	url = https://github.com/webmproject/libwebp.git
	shallow = true
[submodule "shared"]
	path = shared
	url = https://github.com/klaipher/nanogram-deps.git
	branch = main
	shallow = true
[submodule "third-party/openh264/openh264"]
	path = third-party/openh264/openh264
	url = https://github.com/klaipher/openh264.git
	branch = nanogram
	shallow = true
[submodule "third-party/rnnoise/rnnoise"]
	path = third-party/rnnoise/rnnoise
	url = https://github.com/klaipher/rnnoise.git
	branch = nanogram
	shallow = true
[submodule "third-party/libprisma/libprisma"]
	path = third-party/libprisma/libprisma
	url = https://github.com/klaipher/libprisma.git
	branch = nanogram
	shallow = true
