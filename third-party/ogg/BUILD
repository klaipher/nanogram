load("@rules_cc//cc:cc_library.bzl", "cc_library")

# libogg v1.3.6 (be05b13e) from the xiph/ogg submodule in ogg/, the same commit Android pins.
# ogg/include/ogg/config_types.h is generated by upstream's build, so the checked-in generated
# header lives in overlay/ogg/ (the only file that does not come from the submodule).
cc_library(
    name = "ogg",
    srcs = [
        "ogg/src/bitwise.c",
        "ogg/src/crctable.h",
        "ogg/src/framing.c",
    ],
    hdrs = [
        "ogg/include/ogg/ogg.h",
        "ogg/include/ogg/os_types.h",
        "overlay/ogg/config_types.h",
    ],
    includes = [
        "ogg/include",
        "overlay",
    ],
    copts = [
    ],
    visibility = [
        "//visibility:public",
    ],
)
