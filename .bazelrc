build --action_env=ZERO_AR_DATE=1

build --enable_platform_specific_config

# Download dependencies directly if the remote downloader configured by --cacheHost fails.
build --experimental_remote_downloader_local_fallback

# Keeps $(TARGET_CPU) as "ios_sim_arm64" rather than "aarch64". Removing this does not
# fail the build: the third-party genrules silently pick the wrong build directory.
build --noincompatible_target_cpu_from_platform

# macOS-specific settings (auto-applied on macOS via --enable_platform_specific_config)
build:macos --features=debug_prefix_map_pwd_is_dot
build:macos --features=swift.cacheable_swiftmodules
build:macos --features=swift.debug_prefix_map
build:macos --features=swift.enable_vfsoverlays
build:dbg --features=swift.emit_swiftsourceinfo

# Linux-specific settings (auto-applied on Linux via --enable_platform_specific_config)
build:linux --action_env=CC
build:linux --action_env=CXX

build --strategy=Genrule=standalone
build --spawn_strategy=standalone

build:macos --strategy=SwiftCompile=worker

common:macos --features=swift.use_global_module_cache
common:macos --features=oso_prefix_is_pwd

# --- Local development: speed and disk usage --------------------------------
# Watch the source tree with FSEvents instead of re-stat'ing ~49k files on every
# build, which makes no-op and small incremental builds noticeably faster.
common:macos --watchfs

# The disk cache (Make.py --cacheDir) grows without limit by default. Keep it
# bounded: entries unused for two weeks, or the oldest past 40 GB, are removed
# in the background once the Bazel server has been idle for a few minutes.
# Override either value in user.bazelrc. (Bazel 9.3 still names these
# --experimental_disk_cache_gc_*; newer releases drop the prefix.)
common --experimental_disk_cache_gc_max_size=40G
common --experimental_disk_cache_gc_max_age=14d

# Hardlink downloaded archives (Rust/Go toolchains, CMake, wasi-sdk, crates)
# from the repository cache into external/ instead of copying them.
common --experimental_repository_cache_hardlinks

# Build-time tools (Rust proc-macros, build scripts and uniffi-bindgen, the SwiftTL
# code generator, C/C++ helpers) are built unoptimized, as Cargo does for build
# dependencies. They only generate code, so their output is the same either way.
# They were ~860 actions and ~1,240 CPU-seconds of a cold build, and the Rust tool
# chain behind the wallet bindings (uniffi-bindgen alone: 98 s) sat at the start of
# the critical path, ahead of every Swift module that depends on WalletContext.
build --host_compilation_mode=fastbuild

# apple_support's layering check is a beta lint that is on by default. It does not
# change any output, and generating its module maps took ~30 s at the very start
# of every cold build (on the critical path).
common --repo_env=APPLE_SUPPORT_LAYERING_CHECK_BETA=0

# Per-developer overrides (disk cache path, jobs, ...). Not checked in.
try-import %workspace%/user.bazelrc
