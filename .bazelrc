build --action_env=ZERO_AR_DATE=1

build --enable_platform_specific_config

# Download dependencies directly if the remote downloader configured by --cacheHost fails.
build --experimental_remote_downloader_local_fallback

# Keeps $(TARGET_CPU) as "ios_sim_arm64" rather than "aarch64". Removing this does not
# fail the build: the third-party genrules silently pick the wrong build directory.
build --noincompatible_target_cpu_from_platform

# macOS-specific settings (auto-applied on macOS via --enable_platform_specific_config)
build:macos --features=debug_prefix_map_pwd_is_dot
build:macos --features=swift.cacheable_swiftmodules
build:macos --features=swift.debug_prefix_map
build:macos --features=swift.enable_vfsoverlays
build:dbg --features=swift.emit_swiftsourceinfo

# Linux-specific settings (auto-applied on Linux via --enable_platform_specific_config)
build:linux --action_env=CC
build:linux --action_env=CXX

build --strategy=Genrule=standalone
build --spawn_strategy=standalone

build:macos --strategy=SwiftCompile=worker

common:macos --features=swift.use_global_module_cache
common:macos --features=oso_prefix_is_pwd

# --- Local development: speed and disk usage --------------------------------
# Watch the source tree with FSEvents instead of re-stat'ing ~49k files on every
# build, which makes no-op and small incremental builds noticeably faster.
common:macos --watchfs

# The disk cache (Make.py --cacheDir) grows without limit by default. Keep it
# bounded: entries unused for two weeks, or the oldest past 20 GB, are removed
# in the background once the Bazel server has been idle for a few minutes.
# Override either value in user.bazelrc. (Bazel 9.3 still names these
# --experimental_disk_cache_gc_*; newer releases drop the prefix.)
common --experimental_disk_cache_gc_max_size=20G
common --experimental_disk_cache_gc_max_age=14d

# Each worktree has its own Bazel server (8-30 GB of output base behind it). The default keeps an idle server for
# 3 hours; 30 minutes is still longer than the 5 idle minutes the disk-cache GC above needs, and a server also exits
# when the machine runs low on memory. Changing a startup option restarts each server once. The shared cache
# cleanup (tools/dev/cachegc) stops servers whose worktree is gone. Keep in step with shared/cache-policy.json
# (bazel_max_idle_secs; `tg cache-cleanup verify` checks it).
startup --max_idle_secs=1800
startup --shutdown_on_low_sys_mem

# Hardlink downloaded archives (Rust/Go toolchains, CMake, wasi-sdk, crates)
# from the repository cache into external/ instead of copying them.
common --experimental_repository_cache_hardlinks

# Build-time tools (Rust proc-macros, build scripts and uniffi-bindgen, the SwiftTL
# code generator, C/C++ helpers) are built unoptimized, as Cargo does for build
# dependencies. They only generate code, so their output is the same either way.
# They were ~860 actions and ~1,240 CPU-seconds of a cold build, and the Rust tool
# chain behind the wallet bindings (uniffi-bindgen alone: 98 s) sat at the start of
# the critical path, ahead of every Swift module that depends on WalletContext.
build --host_compilation_mode=fastbuild

# --- Memory-safety hardening for the C, C++ and Objective-C we compile (target configuration only) ----------------
# Automatic variables start zeroed instead of holding stale stack bytes; libc++ traps on out-of-bounds container
# access and invalid ranges in constant time; every function with a local array or address-taken local gets a
# stack canary. Assembly files are unaffected. The Mac app sets the same three in nanogram/Nanogram.xcconfig.
# Libraries built by their own scripts (dav1d, libvpx, opus, libwebp, libjpeg-turbo) take their flags from those
# scripts, not from here; FFmpeg's script adds the stack protector only.
build --copt=-ftrivial-auto-var-init=zero
build --copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST
build --copt=-fstack-protector-strong

# Outline atomics (SHARED-APPLE-CPU-1): BLOCKED, config withdrawn. `-moutline-atomics` for arm64-apple-ios makes clang call
# ___aarch64_ldadd4_acq_rel and friends (three underscores), but Xcode's libclang_rt.ios.a defines them with two
# (__aarch64_ldadd4_acq_rel), so the device link fails with "Undefined symbols". Re-enable only with a forwarding shim that
# a full `tg build --device` proves, or replace by -mcpu=apple-a11/a12 once the iOS floor is raised. See docs/performance/outline-atomics.md.

# apple_support's layering check is a beta lint that is on by default. It does not
# change any output, and generating its module maps took ~30 s at the very start
# of every cold build (on the critical path).
common --repo_env=APPLE_SUPPORT_LAYERING_CHECK_BETA=0

# rules_rust pipelined compilation: dependent crates start from the .rmeta of a dependency instead of waiting for
# its full codegen (one extra short rustc invocation per rlib). The Rust phase (wallet and mtproto crate universes,
# uniffi-bindgen at the start of the cold critical path) gets shorter. Outputs do not change. Measure with a cold
# build and `tg profile` (docs/bazel-build-profiling.md); drop the line if the cold wall time does not improve.
# https://github.com/bazelbuild/rules_rust/blob/0.75.0/rust/settings/settings.bzl (pipelined_compilation)
build --@rules_rust//rust/settings:pipelined_compilation=true

# Every build already writes command.profile.gz (generate_json_trace_profile=auto). Put the target label and the
# primary output on each action event so the trace in ui.perfetto.dev names what an action built. Neither flag changes
# the configuration, so the analysis cache survives. `tg profile` copies and summarises the profile.
# https://bazel.build/reference/command-line-reference#flag--experimental_profile_include_target_label
build --experimental_profile_include_target_label
build --experimental_profile_include_primary_output

# Per-developer overrides (disk cache path, jobs, ...). Not checked in.
try-import %workspace%/user.bazelrc
